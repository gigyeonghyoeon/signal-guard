        <mxCell id="e15" value="관제 정보" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#2c3e50;strokeWidth=1;fontFamily=Malgun Gothic;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;strokeColor=#1a5276;strokeWidth=1.5;exitX=1;exitY=0.7667;exitDx=0;exitDy=0;entryX=0;entryY=0.7105;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="admin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e16" value="통제 결과" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#2c3e50;strokeWidth=1;fontFamily=Malgun Gothic;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;strokeColor=#1a5276;strokeWidth=1.5;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.8158;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="admin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="note" value="현장 신호제어기는 경계 밖이며 데이터 흐름이 없다. 이 장에 상자로 두지 않는다.&lt;br&gt;계획 조회·신호 계획은 승인 후에만 있다. 미승인이면 이 두 흐름은 없고, 계획은 관리자의 계획 통제와 시드로 채운다.&lt;br&gt;수집 요청은 실시간 호출을 할 때만 있다. 녹화 픽스처를 읽을 때는 API로 나가는 화살표를 그리지 않는다.&lt;br&gt;운영자에서 나가는 데이터는 조회 요청과 이슈 코멘트뿐이다. 통제 데이터는 관리자에게서만 나온다." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=6;fillColor=#fafafa;strokeColor=#d5d8dc;fontFamily=Malgun Gothic;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="36" y="820" width="1240" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
